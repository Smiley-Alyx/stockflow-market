:root {
    color: #17201b;
    background: #f6f8f4;
    font-family:
        Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-width: 320px;
    background:
        linear-gradient(135deg, rgba(31, 96, 74, 0.12), transparent 34%),
        linear-gradient(315deg, rgba(190, 92, 48, 0.12), transparent 30%),
        #f6f8f4;
}

button,
input,
textarea,
select {
    font: inherit;
}

.shell {
    display: grid;
    gap: 24px;
    width: unquote("min(1120px, calc(100% - 32px))");
    margin: 0 auto;
    padding: 28px 0;
}

.overview {
    display: grid;
    gap: 48px;
    min-height: 58vh;
    padding: 24px;
    border: 1px solid rgba(23, 32, 27, 0.1);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 24px 70px rgba(30, 45, 39, 0.08);
}

.topbar,
.hero,
.content-grid,
.panel-heading,
.category-list li,
.topbar-actions,
.lookup-form div {
    display: flex;
    align-items: center;
}

.topbar {
    justify-content: space-between;
    gap: 16px;
}

.brand-block {
    display: grid;
    gap: 4px;
    min-width: 0;
}

.brand-block p {
    margin-bottom: 0;
    color: #6e7a74;
    font-size: 0.82rem;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    font-weight: 700;
}

.brand-mark {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: #f8fbf7;
    background: #1f604a;
    font-size: 0.78rem;
}

.topbar-actions {
    justify-content: flex-end;
    gap: 10px;
    min-width: 0;
}

.topbar-actions a {
    flex: 0 1 auto;
    min-width: 0;
    border: 1px solid rgba(23, 32, 27, 0.12);
    border-radius: 8px;
    padding: 7px 10px;
    color: #174c39;
    background: #ffffff;
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
}

.counter {
    flex: 0 0 auto;
    border-radius: 999px;
    padding: 6px 10px;
    color: #174c39;
    background: #edf6f1;
    font-size: 0.78rem;
    font-weight: 800;
}

.status {
    flex: 0 0 auto;
    border-radius: 999px;
    padding: 6px 10px;
    color: #174c39;
    background: #dff4e8;
    font-size: 0.82rem;
    font-weight: 700;
}

.status-muted {
    color: #6c3a22;
    background: #ffe5d5;
}

.hero {
    justify-content: space-between;
    gap: 32px;
}

.hero-copy {
    max-width: 680px;
}

.eyebrow {
    margin: 0 0 12px;
    color: #be5c30;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
}

h1,
h2,
p {
    margin-top: 0;
}

h1 {
    max-width: 760px;
    margin-bottom: 18px;
    font-size: unquote("clamp(2.4rem, 7vw, 5.7rem)");
    line-height: 0.96;
    letter-spacing: 0;
}

.lede {
    max-width: 620px;
    margin-bottom: 0;
    color: #52635b;
    font-size: 1.12rem;
    line-height: 1.65;
}

.metrics {
    display: grid;
    gap: 12px;
    width: unquote("min(100%, 260px)");
}

.metrics article,
.panel {
    border: 1px solid rgba(23, 32, 27, 0.1);
    border-radius: 8px;
    background: #ffffff;
}

.metrics article {
    display: grid;
    gap: 4px;
    padding: 18px;
}

.metrics span,
.panel-heading span,
.category-list code {
    color: #6e7a74;
    font-size: 0.82rem;
}

.metrics strong {
    font-size: 1.45rem;
}

.content-grid {
    align-items: stretch;
    gap: 24px;
    flex-wrap: wrap;
}

.panel {
    flex: 1 1 300px;
    min-width: 0;
    padding: 22px;
}

.panel-heading {
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
}

h2 {
    margin-bottom: 0;
    font-size: 1.05rem;
}

.filter-row {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
    overflow-x: auto;
    padding-bottom: 2px;
}

.filter-row button {
    flex: 0 0 auto;
    min-height: 34px;
    border: 1px solid rgba(23, 32, 27, 0.12);
    border-radius: 8px;
    padding: 0 11px;
    color: #52635b;
    background: #f8faf7;
    font-size: 0.82rem;
    font-weight: 800;
    cursor: pointer;
}

.filter-row button.active {
    border-color: #1f604a;
    color: #ffffff;
    background: #1f604a;
}

.category-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.category-list li {
    justify-content: space-between;
    gap: 14px;
    min-height: 46px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(23, 32, 27, 0.08);
}

.category-list li:last-child {
    border-bottom: 0;
}

.category-list div {
    display: grid;
    gap: 4px;
    min-width: 0;
}

.category-list span {
    overflow-wrap: anywhere;
    font-weight: 700;
}

.category-list small {
    color: #6e7a74;
    font-size: 0.78rem;
}

.category-list code {
    flex: 0 1 auto;
    overflow-wrap: anywhere;
}

.product-list-panel {
    flex-basis: 360px;
}

.product-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.product-select {
    display: grid;
    gap: 5px;
    width: 100%;
    min-height: 88px;
    border: 1px solid rgba(23, 32, 27, 0.1);
    border-radius: 8px;
    padding: 14px;
    color: #17201b;
    background: #fbfcfa;
    text-align: left;
    cursor: pointer;
}

.product-select:hover {
    border-color: rgba(31, 96, 74, 0.34);
    background: #f4faf7;
}

.product-list span,
.product-list code {
    color: #6e7a74;
    font-size: 0.82rem;
}

.product-list strong {
    overflow-wrap: anywhere;
}

.product-actions,
.quantity-actions,
.mode-switch {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.product-actions {
    margin-top: 10px;
}

.product-actions button,
.quantity-actions button,
.customer-list > li > button,
.mode-switch button,
.primary-button {
    min-height: 34px;
    border: 1px solid rgba(31, 96, 74, 0.2);
    border-radius: 8px;
    padding: 0 11px;
    color: #174c39;
    background: #f4faf7;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
}

.product-actions button:first-child,
.primary-button {
    border-color: #1f604a;
    color: #ffffff;
    background: #1f604a;
}

.customer-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.customer-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(23, 32, 27, 0.08);
}

.customer-list li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
}

.customer-list div:not(.quantity-actions),
.account-user {
    display: grid;
    gap: 4px;
}

.customer-list code,
.account-user span {
    color: #6e7a74;
    font-size: 0.78rem;
}

.quantity-actions .danger,
.customer-list .danger {
    border-color: rgba(190, 92, 48, 0.2);
    color: #8b4327;
    background: #fff6f1;
}

.lookup-form {
    display: grid;
    gap: 8px;
    margin-bottom: 20px;
}

.lookup-form label {
    color: #53635c;
    font-size: 0.82rem;
    font-weight: 700;
}

.lookup-form div {
    gap: 10px;
}

.lookup-form input {
    min-width: 0;
    width: 100%;
    height: 42px;
    border: 1px solid rgba(23, 32, 27, 0.16);
    border-radius: 8px;
    padding: 0 12px;
    color: #17201b;
    background: #ffffff;
}

.lookup-form button {
    flex: 0 0 auto;
    height: 42px;
    border: 0;
    border-radius: 8px;
    padding: 0 16px;
    color: #ffffff;
    background: #1f604a;
    font-weight: 800;
    cursor: pointer;
}

.lookup-form button:disabled {
    cursor: wait;
    opacity: 0.62;
}

.product-summary {
    display: grid;
    gap: 16px;
}

.product-summary > div {
    display: grid;
    gap: 5px;
}

.product-summary span,
.product-summary code,
.attribute-list dt {
    color: #6e7a74;
    font-size: 0.82rem;
}

.product-summary strong {
    font-size: 1.35rem;
}

.product-summary p {
    margin-bottom: 0;
    color: #52635b;
    line-height: 1.6;
}

.attribute-list {
    display: grid;
    grid-template-columns: minmax(90px, auto) 1fr;
    gap: 8px 12px;
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid rgba(23, 32, 27, 0.08);
}

.attribute-list dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
    font-weight: 700;
}

.empty-state {
    margin-bottom: 0;
    color: #66746d;
    line-height: 1.6;
}

.account-panel {
    flex-basis: 360px;
}

.account-user,
.account-note,
.form-error {
    margin-bottom: 14px;
}

.account-note {
    color: #66746d;
    font-size: 0.88rem;
    line-height: 1.5;
}

.form-error {
    color: #a14728;
    font-size: 0.88rem;
}

.mode-switch {
    margin-bottom: 14px;
}

.mode-switch button.active {
    border-color: #1f604a;
    color: #ffffff;
    background: #1f604a;
}

.auth-form {
    display: grid;
    gap: 10px;
    margin-bottom: 14px;
}

.auth-form input {
    min-width: 0;
    height: 42px;
    border: 1px solid rgba(23, 32, 27, 0.16);
    border-radius: 8px;
    padding: 0 12px;
    color: #17201b;
    background: #ffffff;
}

.primary-button {
    min-height: 42px;
}

.primary-button:disabled {
    cursor: wait;
    opacity: 0.62;
}

.accent-panel {
    background: #18352c;
    color: #f7fbf6;
}

.accent-panel .panel-heading span {
    color: #b8d6ca;
}

.timeline {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px 14px;
}

.timeline span {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: #18352c;
    background: #f0b35d;
    font-size: 0.78rem;
    font-weight: 800;
}

.timeline p {
    margin-bottom: 0;
    color: #e5f0eb;
    line-height: 1.5;
}

@media (max-width: 760px) {
    .shell {
        width: unquote("min(100% - 20px, 1120px)");
        padding: 10px 0;
    }

    .overview {
        min-height: auto;
        padding: 18px;
    }

    .topbar,
    .hero,
    .content-grid,
    .topbar-actions,
    .lookup-form div {
        align-items: stretch;
        flex-direction: column;
    }

    .topbar-actions a,
    .status {
        text-align: center;
    }

    .customer-list li {
        align-items: stretch;
        flex-direction: column;
    }

    .metrics {
        width: 100%;
    }

    h1 {
        font-size: 2.5rem;
        line-height: 1;
    }
}
