:root {
    color: #17201b;
    background: #f6f8f4;
    font-family:
        Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-width: 320px;
    background:
        linear-gradient(135deg, rgba(31, 96, 74, 0.12), transparent 34%),
        linear-gradient(315deg, rgba(190, 92, 48, 0.12), transparent 30%),
        #f6f8f4;
}

button,
input,
textarea,
select {
    font: inherit;
}

.shell {
    display: grid;
    gap: 24px;
    width: unquote("min(1120px, calc(100% - 32px))");
    margin: 0 auto;
    padding: 28px 0;
}

.overview {
    display: grid;
    gap: 48px;
    min-height: 58vh;
    padding: 24px;
    border: 1px solid rgba(23, 32, 27, 0.1);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 24px 70px rgba(30, 45, 39, 0.08);
}

.topbar,
.hero,
.content-grid,
.panel-heading,
.category-list li,
.topbar-actions,
.lookup-form div {
    display: flex;
    align-items: center;
}

.topbar {
    justify-content: space-between;
    gap: 16px;
}

.brand-block {
    display: grid;
    gap: 4px;
    min-width: 0;
}

.brand-block p {
    margin-bottom: 0;
    color: #6e7a74;
    font-size: 0.82rem;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    font-weight: 700;
}

.brand-mark {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: #f8fbf7;
    background: #1f604a;
    font-size: 0.78rem;
}

.topbar-actions {
    justify-content: flex-end;
    gap: 10px;
    min-width: 0;
}

.topbar-actions a {
    flex: 0 1 auto;
    min-width: 0;
    border: 1px solid rgba(23, 32, 27, 0.12);
    border-radius: 8px;
    padding: 7px 10px;
    color: #174c39;
    background: #ffffff;
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
}

.counter {
    flex: 0 0 auto;
    border-radius: 999px;
    padding: 6px 10px;
    color: #174c39;
    background: #edf6f1;
    font-size: 0.78rem;
    font-weight: 800;
}

.status {
    flex: 0 0 auto;
    border-radius: 999px;
    padding: 6px 10px;
    color: #174c39;
    background: #dff4e8;
    font-size: 0.82rem;
    font-weight: 700;
}

.status-muted {
    color: #6c3a22;
    background: #ffe5d5;
}

.hero {
    justify-content: space-between;
    gap: 32px;
}

.hero-copy {
    max-width: 680px;
}

.eyebrow {
    margin: 0 0 12px;
    color: #be5c30;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
}

h1,
h2,
p {
    margin-top: 0;
}

h1 {
    max-width: 760px;
    margin-bottom: 18px;
    font-size: unquote("clamp(2.4rem, 7vw, 5.7rem)");
    line-height: 0.96;
    letter-spacing: 0;
}

.lede {
    max-width: 620px;
    margin-bottom: 0;
    color: #52635b;
    font-size: 1.12rem;
    line-height: 1.65;
}

.metrics {
    display: grid;
    gap: 12px;
    width: unquote("min(100%, 260px)");
}

.metrics article,
.panel {
    border: 1px solid rgba(23, 32, 27, 0.1);
    border-radius: 8px;
    background: #ffffff;
}

.metrics article {
    display: grid;
    gap: 4px;
    padding: 18px;
}

.metrics span,
.panel-heading span,
.category-list code {
    color: #6e7a74;
    font-size: 0.82rem;
}

.metrics strong {
    font-size: 1.45rem;
}

.content-grid {
    align-items: stretch;
    gap: 24px;
    flex-wrap: wrap;
}

.panel {
    flex: 1 1 300px;
    min-width: 0;
    padding: 22px;
}

.panel-heading {
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
}

h2 {
    margin-bottom: 0;
    font-size: 1.05rem;
}

.filter-row {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
    overflow-x: auto;
    padding-bottom: 2px;
}

.filter-row button {
    flex: 0 0 auto;
    min-height: 34px;
    border: 1px solid rgba(23, 32, 27, 0.12);
    border-radius: 8px;
    padding: 0 11px;
    color: #52635b;
    background: #f8faf7;
    font-size: 0.82rem;
    font-weight: 800;
    cursor: pointer;
}

.filter-row button.active {
    border-color: #1f604a;
    color: #ffffff;
    background: #1f604a;
}

.category-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.category-list li {
    justify-content: space-between;
    gap: 14px;
    min-height: 46px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(23, 32, 27, 0.08);
}

.category-list li:last-child {
    border-bottom: 0;
}

.category-list div {
    display: grid;
    gap: 4px;
    min-width: 0;
}

.category-list span {
    overflow-wrap: anywhere;
    font-weight: 700;
}

.category-list small {
    color: #6e7a74;
    font-size: 0.78rem;
}

.category-list code {
    flex: 0 1 auto;
    overflow-wrap: anywhere;
}

.product-list-panel {
    flex-basis: 360px;
}

.product-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.product-select {
    display: grid;
    gap: 5px;
    width: 100%;
    min-height: 88px;
    border: 1px solid rgba(23, 32, 27, 0.1);
    border-radius: 8px;
    padding: 14px;
    color: #17201b;
    background: #fbfcfa;
    text-align: left;
    cursor: pointer;
}

.product-select:hover {
    border-color: rgba(31, 96, 74, 0.34);
    background: #f4faf7;
}

.product-list span,
.product-list code {
    color: #6e7a74;
    font-size: 0.82rem;
}

.product-list strong {
    overflow-wrap: anywhere;
}

.product-actions,
.quantity-actions,
.mode-switch {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.product-actions {
    margin-top: 10px;
}

.product-actions button,
.quantity-actions button,
.customer-list > li > button,
.mode-switch button,
.primary-button {
    min-height: 34px;
    border: 1px solid rgba(31, 96, 74, 0.2);
    border-radius: 8px;
    padding: 0 11px;
    color: #174c39;
    background: #f4faf7;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
}

.product-actions button:first-child,
.primary-button {
    border-color: #1f604a;
    color: #ffffff;
    background: #1f604a;
}

.customer-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.customer-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(23, 32, 27, 0.08);
}

.customer-list li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
}

.customer-list div:not(.quantity-actions),
.account-user {
    display: grid;
    gap: 4px;
}

.customer-list code,
.account-user span {
    color: #6e7a74;
    font-size: 0.78rem;
}

.quantity-actions .danger,
.customer-list .danger {
    border-color: rgba(190, 92, 48, 0.2);
    color: #8b4327;
    background: #fff6f1;
}

.lookup-form {
    display: grid;
    gap: 8px;
    margin-bottom: 20px;
}

.lookup-form label {
    color: #53635c;
    font-size: 0.82rem;
    font-weight: 700;
}

.lookup-form div {
    gap: 10px;
}

.lookup-form input {
    min-width: 0;
    width: 100%;
    height: 42px;
    border: 1px solid rgba(23, 32, 27, 0.16);
    border-radius: 8px;
    padding: 0 12px;
    color: #17201b;
    background: #ffffff;
}

.lookup-form button {
    flex: 0 0 auto;
    height: 42px;
    border: 0;
    border-radius: 8px;
    padding: 0 16px;
    color: #ffffff;
    background: #1f604a;
    font-weight: 800;
    cursor: pointer;
}

.lookup-form button:disabled {
    cursor: wait;
    opacity: 0.62;
}

.product-summary {
    display: grid;
    gap: 16px;
}

.product-card-panel {
    flex-basis: 100%;
}

.product-card {
    display: grid;
    grid-template-columns: minmax(260px, 0.9fr) minmax(280px, 1.1fr);
    gap: 24px;
}

.product-media,
.product-core,
.product-details {
    display: grid;
    align-content: start;
    gap: 14px;
}

.product-main-image {
    display: grid;
    place-items: center;
    min-height: 320px;
    overflow: hidden;
    border: 1px solid rgba(23, 32, 27, 0.1);
    border-radius: 8px;
    color: #6e7a74;
    background: #f8faf7;
}

.product-main-image img {
    width: 100%;
    height: 320px;
    object-fit: contain;
}

.product-gallery {
    display: flex;
    gap: 8px;
    overflow-x: auto;
}

.product-gallery button {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    overflow: hidden;
    border: 1px solid rgba(23, 32, 27, 0.12);
    border-radius: 8px;
    padding: 3px;
    background: #ffffff;
    cursor: pointer;
}

.product-gallery button.active {
    border-color: #1f604a;
}

.product-gallery img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.product-core h3,
.product-details h3 {
    margin: 0;
}

.product-core h3 {
    font-size: 1.75rem;
}

.product-category,
.product-brand {
    color: #6e7a74;
    font-size: 0.88rem;
}

.product-brand,
.product-short {
    margin-bottom: 0;
}

.product-price {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.product-price strong {
    font-size: 1.65rem;
}

.product-price del {
    color: #8a9690;
}

.product-price span {
    border-radius: 999px;
    padding: 4px 8px;
    color: #8b4327;
    background: #fff0e8;
    font-size: 0.78rem;
    font-weight: 800;
}

.product-details {
    grid-column: 1 / -1;
    padding-top: 18px;
    border-top: 1px solid rgba(23, 32, 27, 0.08);
}

.product-details p {
    margin-bottom: 0;
    color: #52635b;
    line-height: 1.6;
}

.warehouse-list,
.document-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.warehouse-list li,
.document-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px;
    border: 1px solid rgba(23, 32, 27, 0.08);
    border-radius: 8px;
    color: #17201b;
    background: #fbfcfa;
}

.warehouse-list div,
.document-list a {
    display: grid;
    gap: 4px;
}

.warehouse-list span,
.document-list span,
.document-list small {
    color: #6e7a74;
    font-size: 0.8rem;
}

.warehouse-list b {
    color: #8b4327;
    font-size: 0.82rem;
}

.warehouse-list b.available {
    color: #1f604a;
}

.document-list a {
    justify-content: start;
    text-decoration: none;
}

.product-summary > div {
    display: grid;
    gap: 5px;
}

.product-summary span,
.product-summary code,
.attribute-list dt {
    color: #6e7a74;
    font-size: 0.82rem;
}

.product-summary strong {
    font-size: 1.35rem;
}

.product-summary p {
    margin-bottom: 0;
    color: #52635b;
    line-height: 1.6;
}

.attribute-list {
    display: grid;
    grid-template-columns: minmax(90px, auto) 1fr;
    gap: 8px 12px;
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid rgba(23, 32, 27, 0.08);
}

.attribute-list dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
    font-weight: 700;
}

.attribute-list.compact {
    padding-top: 0;
    border-top: 0;
}

.empty-state {
    margin-bottom: 0;
    color: #66746d;
    line-height: 1.6;
}

.account-panel {
    flex-basis: 360px;
}

.account-user,
.account-note,
.form-error {
    margin-bottom: 14px;
}

.account-note {
    color: #66746d;
    font-size: 0.88rem;
    line-height: 1.5;
}

.form-error {
    color: #a14728;
    font-size: 0.88rem;
}

.mode-switch {
    margin-bottom: 14px;
}

.mode-switch button.active {
    border-color: #1f604a;
    color: #ffffff;
    background: #1f604a;
}

.auth-form {
    display: grid;
    gap: 10px;
    margin-bottom: 14px;
}

.auth-form input {
    min-width: 0;
    height: 42px;
    border: 1px solid rgba(23, 32, 27, 0.16);
    border-radius: 8px;
    padding: 0 12px;
    color: #17201b;
    background: #ffffff;
}

.primary-button {
    min-height: 42px;
}

.primary-button:disabled {
    cursor: wait;
    opacity: 0.62;
}

.secondary-button {
    min-height: 42px;
    border: 1px solid rgba(31, 96, 74, 0.26);
    border-radius: 8px;
    padding: 0 12px;
    color: #174c39;
    background: #f4faf7;
    font-weight: 800;
    cursor: pointer;
}

.secondary-button:disabled {
    cursor: wait;
    opacity: 0.62;
}

.cart-shell {
    gap: 32px;
}

.cart-header,
.cart-title,
.cart-layout,
.select-all,
.cart-page-list li,
.removed-list li {
    display: flex;
    align-items: center;
}

.cart-header,
.cart-title {
    justify-content: space-between;
    gap: 20px;
}

.back-link {
    color: #174c39;
    font-size: 0.88rem;
    font-weight: 800;
}

.cart-title {
    padding: 28px;
    border: 1px solid rgba(23, 32, 27, 0.1);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.72);
}

.cart-title h1 {
    margin-bottom: 12px;
}

.cart-mode {
    flex: 0 0 auto;
    border-radius: 999px;
    padding: 7px 11px;
    color: #174c39;
    background: #dff4e8;
    font-size: 0.82rem;
    font-weight: 800;
}

.cart-layout {
    align-items: flex-start;
    gap: 24px;
}

.cart-items-panel {
    flex: 1 1 auto;
}

.select-all {
    gap: 8px;
    margin-bottom: 18px;
    color: #52635b;
    font-size: 0.88rem;
    font-weight: 800;
}

.cart-page-list,
.removed-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.cart-page-list li {
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(23, 32, 27, 0.08);
}

.cart-product-image {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 68px;
    height: 68px;
    overflow: hidden;
    border-radius: 8px;
    color: #7f8d86;
    background: #f2f6f3;
    font-size: 0.76rem;
    font-weight: 800;
}

.cart-product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.cart-product-copy {
    display: grid;
    flex: 1 1 auto;
    gap: 4px;
    min-width: 0;
}

.cart-product-copy code,
.cart-product-copy small,
.removed-list code {
    color: #6e7a74;
    font-size: 0.78rem;
}

.cart-remove,
.removed-list button {
    min-height: 34px;
    border: 1px solid rgba(190, 92, 48, 0.2);
    border-radius: 8px;
    padding: 0 11px;
    color: #8b4327;
    background: #fff6f1;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
}

.removed-heading {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 28px 0 14px;
    padding-top: 20px;
    border-top: 1px solid rgba(23, 32, 27, 0.08);
}

.removed-heading span {
    color: #6e7a74;
    font-size: 0.82rem;
}

.removed-list li {
    justify-content: space-between;
    gap: 14px;
}

.removed-list div {
    display: grid;
    gap: 4px;
}

.removed-list button {
    border-color: rgba(31, 96, 74, 0.2);
    color: #174c39;
    background: #f4faf7;
}

.cart-summary-panel {
    display: grid;
    flex: 0 0 300px;
    gap: 12px;
}

.cart-summary-panel .panel-heading {
    margin-bottom: 4px;
}

.cart-totals {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px 14px;
    margin: 0 0 8px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(23, 32, 27, 0.08);
}

.cart-totals dt {
    color: #6e7a74;
}

.cart-totals dd {
    margin: 0;
    font-weight: 800;
}

.checkout-message {
    margin-bottom: 0;
    color: #1f604a;
    font-size: 0.88rem;
    line-height: 1.5;
}

.checkout-layout {
    display: flex;
    align-items: flex-start;
    gap: 24px;
}

.checkout-main {
    display: grid;
    flex: 1 1 auto;
    gap: 18px;
}

.checkout-section {
    display: grid;
    gap: 14px;
}

.checkout-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.checkout-fields label,
.checkout-service {
    display: grid;
    gap: 6px;
}

.checkout-fields span,
.checkout-service span {
    color: #52635b;
    font-size: 0.8rem;
    font-weight: 800;
}

.checkout-fields input,
.checkout-service select,
.checkout-item-list select {
    min-width: 0;
    height: 42px;
    border: 1px solid rgba(23, 32, 27, 0.16);
    border-radius: 8px;
    padding: 0 12px;
    color: #17201b;
    background: #ffffff;
}

.checkout-field-wide {
    grid-column: 1 / -1;
}

.checkout-options {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.checkout-options label {
    display: flex;
    align-items: center;
    gap: 7px;
    border: 1px solid rgba(23, 32, 27, 0.1);
    border-radius: 8px;
    padding: 11px 12px;
    color: #52635b;
    background: #fbfcfa;
    font-size: 0.88rem;
    font-weight: 800;
}

.checkout-item-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.checkout-item-list li {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) auto minmax(150px, 0.6fr);
    align-items: center;
    gap: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(23, 32, 27, 0.08);
}

.checkout-item-list div {
    display: grid;
    gap: 4px;
}

.checkout-item-list code {
    color: #6e7a74;
    font-size: 0.78rem;
}

.checkout-item-list label {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #52635b;
    font-size: 0.8rem;
    font-weight: 800;
}

.checkout-total {
    font-size: 1.8rem;
}

.accent-panel {
    background: #18352c;
    color: #f7fbf6;
}

.accent-panel .panel-heading span {
    color: #b8d6ca;
}

.timeline {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px 14px;
}

.timeline span {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: #18352c;
    background: #f0b35d;
    font-size: 0.78rem;
    font-weight: 800;
}

.timeline p {
    margin-bottom: 0;
    color: #e5f0eb;
    line-height: 1.5;
}

@media (max-width: 760px) {
    .shell {
        width: unquote("min(100% - 20px, 1120px)");
        padding: 10px 0;
    }

    .overview {
        min-height: auto;
        padding: 18px;
    }

    .topbar,
    .hero,
    .content-grid,
    .topbar-actions,
    .lookup-form div {
        align-items: stretch;
        flex-direction: column;
    }

    .topbar-actions a,
    .status {
        text-align: center;
    }

    .customer-list li {
        align-items: stretch;
        flex-direction: column;
    }

    .product-card {
        grid-template-columns: 1fr;
    }

    .cart-layout,
    .cart-title,
    .checkout-layout {
        align-items: stretch;
        flex-direction: column;
    }

    .cart-summary-panel {
        flex-basis: auto;
        width: 100%;
    }

    .cart-page-list li {
        align-items: flex-start;
