    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 24px;
    padding-bottom: 70px;
}

.product-info-main,
.product-stock-panel {
    border: 1px solid rgba(23, 32, 27, 0.08);
    border-radius: 17px;
    background: #ffffff;
