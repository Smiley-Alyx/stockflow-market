    "title": "catalog.product.archived payload v1",
    "type": "object",
    "required": ["event", "product"],
    "properties": {
        "event": {"const": "catalog.product.archived"},
        "product": {
            "type": "object",
            "required": ["id", "category_id", "name", "slug", "sku", "status", "published_at"],
            "properties": {
                "id": {"type": "integer"},
                "category_id": {"type": "integer"},
                "name": {"type": "string"},
                "slug": {"type": "string"},
                "sku": {"type": "string"},
                "status": {"type": "string"},
                "published_at": {"type": ["string", "null"]}
            },
            "additionalProperties": true
        }
    },
    "additionalProperties": true
}
