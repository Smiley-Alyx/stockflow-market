{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://stockflow.local/contracts/domain-events/v1/inventory.stock.changed.schema.json",
    "title": "inventory.stock.changed payload v1",
    "type": "object",
    "required": ["event", "stock", "movement"],
    "properties": {
        "event": {"const": "inventory.stock.changed"},
        "stock": {
            "type": "object",
            "required": ["warehouse_id", "product_id", "sku", "on_hand_quantity", "reserved_quantity", "available_quantity"],
            "properties": {
                "warehouse_id": {"type": "integer"},
                "product_id": {"type": "integer"},
                "sku": {"type": "string"},
                "on_hand_quantity": {"type": "integer"},
                "reserved_quantity": {"type": "integer"},
                "available_quantity": {"type": "integer"}
            },
            "additionalProperties": true
        },
        "movement": {
            "type": "object",
            "required": ["id", "type", "quantity", "reference_type", "reference_id", "occurred_at"],
            "properties": {
                "id": {"type": "integer"},
                "type": {"type": "string"},
                "quantity": {"type": "integer"},
                "reference_type": {"type": ["string", "null"]},
                "reference_id": {"type": ["string", "null"]},
                "occurred_at": {"type": ["string", "null"]}
            },
            "additionalProperties": true
        }
    },
    "additionalProperties": true
}
