{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://stockflow.local/contracts/domain-event-envelope.v1.schema.json",
    "title": "StockFlow domain event envelope v1",
    "type": "object",
    "required": [
        "event_name",
        "schema_version",
        "aggregate_type",
        "aggregate_id",
        "payload"
    ],
    "properties": {
        "event_name": {
            "type": "string",
            "minLength": 1
        },
        "schema_version": {
            "const": 1
        },
        "aggregate_type": {
            "type": [
                "string",
                "null"
            ]
        },
        "aggregate_id": {
            "type": [
                "string",
                "null"
            ]
        },
        "payload": {
            "type": "object",
            "required": [
                "event"
            ],
            "properties": {
                "event": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    },
    "additionalProperties": false
}
