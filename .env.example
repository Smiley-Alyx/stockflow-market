APP_NAME="StockFlow Market"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=stockflow
DB_USERNAME=stockflow
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=stockflow
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/
STOCKFLOW_PROVIDER_SAGA_PAYMENT_TOKEN=tok_approved_visa
STOCKFLOW_PROVIDER_OUTBOX_PROCESSING_TIMEOUT_SECONDS=60
STOCKFLOW_PROVIDER_OUTBOX_CONFIRM_TIMEOUT_SECONDS=5
STOCKFLOW_PROVIDER_OUTCOMES_QUEUE=stockflow.market.provider.outcomes
STOCKFLOW_PROVIDER_OUTCOMES_RETRY_QUEUE=stockflow.market.provider.outcomes.retry
STOCKFLOW_PROVIDER_OUTCOMES_DLQ=stockflow.market.provider.outcomes.dlq
STOCKFLOW_PROVIDER_OUTCOMES_RETRY_DELAY_MS=2000
STOCKFLOW_PROVIDER_OUTCOMES_MAX_RETRY_COUNT=3
RABBITMQ_ENABLED=false

ELASTICSEARCH_HOST=http://elasticsearch:9200

AI_ASSISTANT_PROVIDER=openai
GIGACHAT_ASSISTANT_DRIVER=
YANDEX_ASSISTANT_DRIVER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TIMEOUT_SECONDS=30

CLICKHOUSE_HOST=http://clickhouse:8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=stockflow
CLICKHOUSE_USERNAME=stockflow
CLICKHOUSE_PASSWORD=secret
CLICKHOUSE_ENABLED=false
STOCKFLOW_ANALYTICS_STOCK_MOVEMENT_REBUILD_BATCH_SIZE=1000

STOCKFLOW_SERVICE_NAME=gateway
STOCKFLOW_FRONTEND_URL=http://localhost:3000
STOCKFLOW_SWAGGER_UI_URL=http://localhost:8084
STOCKFLOW_REQUEST_TIMEOUT_MS=2500
STOCKFLOW_DEPENDENCY_TIMEOUT_SECONDS=2
STOCKFLOW_SHUTDOWN_TIMEOUT_SECONDS=15
STOCKFLOW_FAULT_INJECTION_ENABLED=false
STOCKFLOW_CATALOG_PRODUCT_CACHE_TTL=300
STOCKFLOW_CATALOG_CATEGORY_TREE_CACHE_TTL=900
STOCKFLOW_SEARCH_INDEX_QUEUE=search-indexing
STOCKFLOW_SEARCH_INDEX_DEAD_LETTER_QUEUE=search-indexing-dead-letter
STOCKFLOW_SEARCH_INDEX_DEAD_LETTER_BACKEND=redis
STOCKFLOW_SEARCH_INDEX_DEAD_LETTER_REDIS_CONNECTION=default
STOCKFLOW_SEARCH_INDEX_DEAD_LETTER_REDIS_KEY=stockflow:search:dead-letter
STOCKFLOW_SEARCH_REQUEUE_AUDIT_CHANNEL=search_requeue_audit
STOCKFLOW_SEARCH_REQUEUE_BATCH_SIZE=100
STOCKFLOW_SEARCH_MAX_REQUEUE_BATCH_SIZE=500
STOCKFLOW_SEARCH_INDEX_BATCH_SIZE=100
STOCKFLOW_SEARCH_INDEX_MAX_IN_FLIGHT=500
STOCKFLOW_SEARCH_INDEX_TIMEOUT_MS=1500
STOCKFLOW_SEARCH_INDEX_BULK_TIMEOUT_MS=30000
STOCKFLOW_SEED_SEARCH_INDEX=true
STOCKFLOW_SEED_PRODUCT_COUNT=50000
STOCKFLOW_EVENT_BUS=in_process
STOCKFLOW_DOMAIN_EVENTS_EXCHANGE=stockflow.domain.events
STOCKFLOW_DOMAIN_EVENTS_QUEUE=stockflow.market.domain.events
STOCKFLOW_DOMAIN_EVENTS_RETRY_QUEUE=stockflow.market.domain.events.retry
STOCKFLOW_DOMAIN_EVENTS_DLQ=stockflow.market.domain.events.dlq
STOCKFLOW_DOMAIN_EVENTS_RETRY_DELAY_MS=2000
STOCKFLOW_DOMAIN_EVENTS_MAX_RETRY_COUNT=3
STOCKFLOW_DOMAIN_EVENTS_CONFIRM_TIMEOUT_SECONDS=5
STOCKFLOW_INBOX_PROCESSING_TIMEOUT_SECONDS=60
STOCKFLOW_MESSAGE_RETRY_ATTEMPTS=5
STOCKFLOW_MESSAGE_RETRY_BACKOFF_MS=250
STOCKFLOW_MESSAGE_DEAD_LETTER_AFTER=5

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
