APP_NAME="StockFlow Market"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=stockflow
DB_USERNAME=stockflow
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=stockflow
RABBITMQ_PASSWORD=secret

ELASTICSEARCH_HOST=http://elasticsearch:9200

STOCKFLOW_SERVICE_NAME=gateway
STOCKFLOW_REQUEST_TIMEOUT_MS=2500
STOCKFLOW_DEPENDENCY_TIMEOUT_SECONDS=2
STOCKFLOW_SHUTDOWN_TIMEOUT_SECONDS=15
STOCKFLOW_CATALOG_PRODUCT_CACHE_TTL=300
STOCKFLOW_CATALOG_CATEGORY_TREE_CACHE_TTL=900
STOCKFLOW_SEARCH_INDEX_QUEUE=search-indexing
STOCKFLOW_SEARCH_INDEX_DEAD_LETTER_QUEUE=search-indexing-dead-letter
STOCKFLOW_SEARCH_INDEX_DEAD_LETTER_BACKEND=redis
STOCKFLOW_SEARCH_INDEX_DEAD_LETTER_REDIS_CONNECTION=default
STOCKFLOW_SEARCH_INDEX_DEAD_LETTER_REDIS_KEY=stockflow:search:dead-letter
STOCKFLOW_SEARCH_REQUEUE_AUDIT_CHANNEL=search_requeue_audit
STOCKFLOW_SEARCH_INDEX_BATCH_SIZE=100
STOCKFLOW_SEARCH_INDEX_MAX_IN_FLIGHT=500
STOCKFLOW_SEARCH_INDEX_TIMEOUT_MS=1500
STOCKFLOW_EVENT_BUS=rabbitmq
STOCKFLOW_MESSAGE_RETRY_ATTEMPTS=5
STOCKFLOW_MESSAGE_RETRY_BACKOFF_MS=250
STOCKFLOW_MESSAGE_DEAD_LETTER_AFTER=5

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
